# Copie este arquivo para .env e ajuste os valores.
PORT=4173
HOST=127.0.0.1

# Login com Google (Gmail)
# Google Cloud Console > APIs e Serviços > Credenciais > ID do cliente OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Deve ser exatamente igual ao URI de redirecionamento autorizado no Google.
# Para uso local: http://127.0.0.1:4173/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://127.0.0.1:4173/api/auth/google/callback

# Ative quando servir a aplicação por HTTPS.
NOODLE_SECURE_COOKIES=0

# Diretório do db.json (padrão: .data na raiz do projeto).
# Em produção com disco persistente, use o caminho montado pela hospedagem.
# NOODLE_DATA_DIR=/var/data

# Use 0 para desativar a conta demo em produção.
NOODLE_DEMO=1
